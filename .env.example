# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="MY_APP_URL"

# MQTT Broker Configuration
# Default "embedded" runs a real local TCP MQTT 3.1.1 broker (Aedes) on MQTT_PORT.
# Set MQTT_BROKER_MODE=external and MQTT_BROKER_URL=mqtt://127.0.0.1:1883 to use Eclipse Mosquitto.
MQTT_BROKER_MODE=embedded
MQTT_PORT=1883
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Database Configuration (SQLite persisted file path)
DB_PATH=data/hydro_network.db

# Optional API Key Protection for Mutating Endpoints (leave empty for open local academic demo)
HYDRO_API_KEY=

# Optional Allowed CORS Origin
ALLOWED_ORIGIN=

# Gemini API Key (optional, unused by core MQTT monitoring platform)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
